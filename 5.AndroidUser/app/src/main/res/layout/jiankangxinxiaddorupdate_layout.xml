<?xml version="1.0" encoding="utf-8"?>
<com.design.appproject.widget.MyScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/add_box_style"
    android:fillViewport="true">
    <com.design.appproject.widget.MyLinearLayout
        style="@style/add_form_style"
        android:orientation="vertical">
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/zhanghao_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="账号"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/zhanghao_et"
            style="@style/add_item_input_style"
            android:hint="账号"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xingming_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="姓名"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xingming_et"
            style="@style/add_item_input_style"
            android:hint="姓名"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xingbie_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="性别"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xingbie_et"
            style="@style/add_item_input_style"
            android:hint="性别"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/nianling_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="年龄"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/nianling_et"
            android:inputType="number"
            style="@style/add_item_input_style"
            android:hint="年龄"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/shengao_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="身高"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/shengao_et"
            style="@style/add_item_input_style"
            android:hint="身高"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/tizhong_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="体重"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/tizhong_et"
            style="@style/add_item_input_style"
            android:hint="体重"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xuexing_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="血型"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xuexing_et"
            style="@style/add_item_input_style"
            android:hint="血型"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/tiwen_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="体温"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/tiwen_et"
            style="@style/add_item_input_style"
            android:hint="体温"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xinlv_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="心率"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xinlv_et"
            style="@style/add_item_input_style"
            android:hint="心率"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xueya_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="血压"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xueya_et"
            style="@style/add_item_input_style"
            android:hint="血压"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/xuetang_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="血糖"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/xuetang_et"
            style="@style/add_item_input_style"
            android:hint="血糖"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="录入时间"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyTextView
            android:id="@+id/lurushijian_tv"
            android:text="请选择录入时间"
            style="@style/add_item_picker_box_style"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFrameLayout
        style="@style/add_btn_box_style">
        <com.design.appproject.widget.MyButton
            android:id="@+id/submit_btn"
            android:text="提交"
            android:gravity="center"
        style="@style/add_btn_submit_style"/>
    </com.design.appproject.widget.MyFrameLayout>

    </com.design.appproject.widget.MyLinearLayout>
</com.design.appproject.widget.MyScrollView>
